---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = "Nos Services de Plomberie & Chauffage à Bruxelles | Fbaleste";
const description = "Découvrez l'ensemble de nos services de plomberie à Bruxelles : dépannage d'urgence 24/7, détection de fuite, débouchage, chaudière, robinetterie, WC et adoucisseurs.";

const breadcrumbItems = [
  { name: 'Accueil', url: '/' },
  { name: 'Nos Services' }
];
---

<Layout title={title} description={description}>
  <Header />
  
  <main class="page-content pt-top">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <div class="container header-section text-center animate-fade-in">
      <h1>Nos Services de <span class="highlight">Plomberie à Bruxelles</span></h1>
      <p>Des interventions soignées et durables réalisées par des artisans qualifiés dans les 19 communes de Bruxelles.</p>
    </div>

    <div class="container mt-3 mb-3">
      <div class="services-grid">
        <a href="/depannage-urgence/" class="service-card glass">
          <div class="icon-placeholder">🚨</div>
          <h2>Dépannage d'Urgence 24/7</h2>
          <p>Intervention immédiate jour et nuit pour sécuriser vos fuites d'eau majeures, ruptures de tuyau et pannes sanitaires critiques.</p>
          <span class="read-more">Découvrir le dépannage express →</span>
        </a>

        <a href="/detection-fuite/" class="service-card glass">
          <div class="icon-placeholder">🔬</div>
          <h2>Détection de Fuites Sans Casse</h2>
          <p>Recherche non destructive par caméra thermique infrarouge, gaz traceur et écoute acoustique avec rapport complet pour votre assurance.</p>
          <span class="read-more">Découvrir la détection sans casse →</span>
        </a>

        <a href="/debouchage/" class="service-card glass">
          <div class="icon-placeholder">🚰</div>
          <h2>Débouchage de Canalisation</h2>
          <p>Curage haute pression et débouchage mécanique au furet pour vos WC, éviers, douches et colonnes principales d'égouttage.</p>
          <span class="read-more">Consulter nos solutions de débouchage →</span>
        </a>

        <a href="/chauffage-chaudiere/" class="service-card glass">
          <div class="icon-placeholder">🔥</div>
          <h2>Chauffagiste & Chaudière</h2>
          <p>Dépannage d'urgence de chaudière au gaz, contrôle périodique PEB légal, purge de radiateurs et réglages de combustion.</p>
          <span class="read-more">Voir les prestations chauffage →</span>
        </a>

        <a href="/reparation-robinetterie-bruxelles/" class="service-card glass">
          <div class="icon-placeholder">🚿</div>
          <h2>Réparation de Robinetterie</h2>
          <p>Remplacement de cartouche céramique, réparation de mitigeurs qui gouttent, changement de vannes d'arrêt et pose de robinets neufs.</p>
          <span class="read-more">Découvrir la réparation de robinet →</span>
        </a>

        <a href="/reparation-toilette-chasse-eau-bruxelles/" class="service-card glass">
          <div class="icon-placeholder">🚽</div>
          <h2>Réparation Toilette & Chasse d'Eau</h2>
          <p>Dépannage de chasse d'eau qui coule en continu, remplacement de flotteurs, mécanismes pour WC suspendu Geberit et cuvettes.</p>
          <span class="read-more">Voir les réparations de WC →</span>
        </a>

        <a href="/inspection-camera-canalisation-bruxelles/" class="service-card glass">
          <div class="icon-placeholder">📹</div>
          <h2>Inspection Caméra de Canalisation</h2>
          <p>Diagnostic vidéo précis de vos conduites enterrées pour repérer bouchons récurrents, racines et fissures avec rapport technique.</p>
          <span class="read-more">Accéder au diagnostic vidéo →</span>
        </a>

        <a href="/installation-chauffe-eau-bruxelles/" class="service-card glass">
          <div class="icon-placeholder">⚡</div>
          <h2>Installation Chauffe-Eau & Boiler</h2>
          <p>Pose, remplacement et détartrage de boilers électriques et thermodynamiques avec résistance stéatite adaptée à l'eau de Bruxelles.</p>
          <span class="read-more">Découvrir la pose de chauffe-eau →</span>
        </a>

        <a href="/installations-sanitaires/" class="service-card glass">
          <div class="icon-placeholder">🛁</div>
          <h2>Installations Sanitaires</h2>
          <p>Rénovation complète ou partielle de salle de bain, création de douches à l'italienne, vasques et tuyauteries aux normes belges.</p>
          <span class="read-more">Consulter nos installations sanitaires →</span>
        </a>

        <a href="/traitement-eau/" class="service-card glass">
          <div class="icon-placeholder">💧</div>
          <h2>Adoucisseur & Traitement d'Eau</h2>
          <p>Installation et entretien d'adoucisseurs d'eau anti-calcaire pour préserver vos tuyaux et prolonger la durée de vie de vos appareils.</p>
          <span class="read-more">Découvrir nos adoucisseurs d'eau →</span>
        </a>
      </div>
    </div>
  </main>
  
  <WhatsAppWidget />
  <Footer />
</Layout>

<style>
  .pt-top {
    padding-top: 120px;
  }
  
  .header-section {
    margin-bottom: 3rem;
  }
  
  .header-section h1 {
    font-size: 3rem;
    color: var(--primary);
  }
  
  .highlight {
    color: var(--accent);
  }
  
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
  
  .service-card {
    display: flex;
    flex-direction: column;
    padding: 2.2rem;
    border-radius: 16px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    color: inherit;
  }
  
  .service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 40px 0 rgba(15, 76, 129, 0.15);
  }
  
  .icon-placeholder {
    font-size: 2.5rem;
    margin-bottom: 0.8rem;
  }
  
  .service-card h2 {
    font-size: 1.35rem;
    color: var(--primary);
    margin-bottom: 0.8rem;
  }
  
  .service-card p {
    color: var(--text-muted);
    flex-grow: 1;
    margin-bottom: 1.2rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  
  .read-more {
    font-weight: 700;
    color: var(--accent);
    align-self: flex-start;
    font-size: 0.95rem;
  }
</style>
