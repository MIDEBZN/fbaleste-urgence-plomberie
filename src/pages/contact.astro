---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = "Contactez Fbaleste | Devis Plombier Bruxelles Gratuit";
const description = "Demandez un devis plombier Bruxelles gratuit. Intervention d'urgence 24/7, débouchage ou installation. Contactez Fbaleste Urgence Plomberie.";

const breadcrumbItems = [
  { name: 'Accueil', url: '/' },
  { name: 'Contact' }
];
---

<Layout title={title} description={description}>
  <Header />
  
  <main class="page-content pt-top">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <div class="container header-section text-center animate-fade-in">
      <h1>Demandez votre <span class="highlight">Devis Gratuit</span></h1>
      <p>Une urgence ou un projet ? Nous vous répondons immédiatement.</p>
    </div>

    <div class="container contact-grid mt-3 mb-3">
      <div class="contact-info glass">
        <h2>Coordonnées</h2>
        <p class="mb-2">N'hésitez pas à nous appeler pour toute urgence (24/7) ou à nous envoyer un message avec des photos de votre problème pour une estimation rapide.</p>
        
        <div class="info-item">
          <strong>📞 Téléphone (Urgence 24/7) :</strong>
          <a href="tel:+32465767511">0465 76 75 11</a>
        </div>
        <div class="info-item">
          <strong>💬 WhatsApp :</strong>
          <a href="https://wa.me/32465767511" target="_blank" rel="noopener noreferrer">Envoyer un message WhatsApp</a>
        </div>
        <div class="info-item">
          <strong>✉️ Email :</strong>
          <a href="mailto:contact@urgenceplomberie.be">contact@urgenceplomberie.be</a>
        </div>
        <div class="info-item">
          <strong>📍 Adresse & Base locale :</strong>
          <span>Avenue d'Auderghem 287, 1040 Etterbeek</span>
        </div>
        <div class="info-item">
          <strong>🗺️ Zones Couvertes :</strong>
          <span>Région de Bruxelles-Capitale (19 communes)</span>
        </div>
      </div>

      <div class="contact-form glass">
        <h2>Envoyez-nous un message</h2>
        <form action="https://formsubmit.co/midebzn@gmail.com" method="POST">
          <input type="hidden" name="_subject" value="Nouveau message depuis le site Web Fbaleste !" />
          <input type="hidden" name="_captcha" value="false" />
          <!-- Protection antispam pot-de-miel -->
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
          
          <div class="form-group">
            <label for="name">Nom / Entreprise</label>
            <input type="text" id="name" name="name" required placeholder="Votre nom" autocomplete="name" />
          </div>
          
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required placeholder="votre@email.com" autocomplete="email" />
          </div>
          
          <div class="form-group">
            <label for="phone">Téléphone</label>
            <input type="tel" id="phone" name="phone" required placeholder="04XX XX XX XX" autocomplete="tel" />
          </div>
          
          <div class="form-group">
            <label for="message">Description de votre problème</label>
            <textarea id="message" name="message" rows="5" required placeholder="Ex: J'ai une fuite sous l'évier, un WC bouché, une chaudière en panne..."></textarea>
          </div>
          
          <button type="submit" class="btn btn-primary w-100">Envoyer la demande</button>
          <p class="form-privacy-note">
            🔒 Vos coordonnées sont transmises via le routeur technique FormSubmit pour organiser votre dépannage ou devis. Consultez notre <a href="/politique-confidentialite/">Politique de confidentialité</a>.
          </p>
        </form>
      </div>
    </div>
  </main>
  
  <WhatsAppWidget />
  <Footer hideContactForm={true} />
</Layout>

<style>
  .pt-top {
    padding-top: 120px;
  }
  
  .header-section {
    margin-bottom: 3rem;
  }
  
  .header-section h1 {
    font-size: 3rem;
    color: var(--primary);
  }
  
  .highlight {
    color: var(--accent);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .glass {
    padding: 3rem;
    border-radius: 16px;
  }

  .info-item {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .info-item a, .info-item span {
    color: var(--primary);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .info-item a:hover {
    color: var(--accent);
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: var(--primary);
  }

  input, textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-family: inherit;
    font-size: 1rem;
    transition: border-color 0.3s ease;
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(15, 76, 129, 0.1);
  }

  .w-100 {
    width: 100%;
  }

  .form-privacy-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.75rem;
    line-height: 1.4;
  }

  .form-privacy-note a {
    color: var(--primary);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .glass {
      padding: 1.5rem;
    }
  }
</style>
