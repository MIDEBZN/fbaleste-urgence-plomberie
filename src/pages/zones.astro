---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = "Zones d'Intervention Plombier Bruxelles | Les 19 Communes";
const description = "Intervention plombier rapide sur toute la région de Bruxelles-Capitale. Découvrez nos zones d'intervention : Etterbeek, Auderghem, Ixelles, Uccle, Schaerbeek et alentours.";

const breadcrumbItems = [
  { name: 'Accueil', url: '/' },
  { name: 'Zones d\'intervention' }
];
---

<Layout title={title} description={description}>
  <Header />
  
  <main class="page-content pt-top">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <div class="container header-section text-center animate-fade-in">
      <h1>Nos Zones <span class="highlight">d'Intervention à Bruxelles</span></h1>
      <p>Un plombier qualifié disponible pour vos dépannages et installations sur l'ensemble de la Région Bruxelles-Capitale.</p>
    </div>

    <div class="container glass content-box mt-2 mb-3">
      <div class="text-center mb-2">
        <p>Pour assurer une réactivité optimale et des frais de déplacement maîtrisés, nos techniciens couvrent quotidiennement l'ensemble des 19 communes de Bruxelles. Que vous ayez besoin d'un dépannage à Etterbeek, d'une recherche de fuite à Auderghem ou d'un débouchage à Ixelles, notre équipe est à votre disposition 24/7.</p>
      </div>

      <div class="zones-grid">
        <ul class="zones-list">
          <li><a href="/zones/plombier-bruxelles/">Plombier Bruxelles Centre (1000)</a></li>
          <li><a href="/zones/plombier-schaerbeek/">Plombier Schaerbeek (1030)</a></li>
          <li><a href="/zones/plombier-etterbeek/">Plombier Etterbeek (1040)</a></li>
          <li><a href="/zones/plombier-ixelles/">Plombier Ixelles (1050)</a></li>
          <li><a href="/zones/plombier-saint-gilles/">Plombier Saint-Gilles (1060)</a></li>
          <li><a href="/zones/plombier-saint-josse-ten-noode/">Plombier Saint-Josse-ten-Noode (1210)</a></li>
        </ul>
        <ul class="zones-list">
          <li><a href="/zones/plombier-anderlecht/">Plombier Anderlecht (1070)</a></li>
          <li><a href="/zones/plombier-molenbeek-saint-jean/">Plombier Molenbeek-Saint-Jean (1080)</a></li>
          <li><a href="/zones/plombier-koekelberg/">Plombier Koekelberg (1081)</a></li>
          <li><a href="/zones/plombier-berchem-sainte-agathe/">Plombier Berchem-Sainte-Agathe (1082)</a></li>
          <li><a href="/zones/plombier-ganshoren/">Plombier Ganshoren (1083)</a></li>
          <li><a href="/zones/plombier-jette/">Plombier Jette (1090)</a></li>
        </ul>
        <ul class="zones-list">
          <li><a href="/zones/plombier-evere/">Plombier Evere (1140)</a></li>
          <li><a href="/zones/plombier-woluwe-saint-pierre/">Plombier Woluwe-Saint-Pierre (1150)</a></li>
          <li><a href="/zones/plombier-auderghem/">Plombier Auderghem (1160)</a></li>
          <li><a href="/zones/plombier-watermael-boitsfort/">Plombier Watermael-Boitsfort (1170)</a></li>
          <li><a href="/zones/plombier-uccle/">Plombier Uccle (1180)</a></li>
          <li><a href="/zones/plombier-forest/">Plombier Forest (1190)</a></li>
          <li><a href="/zones/plombier-woluwe-saint-lambert/">Plombier Woluwe-Saint-Lambert (1200)</a></li>
        </ul>
      </div>
    </div>
  </main>
  
  <WhatsAppWidget />
  <Footer />
</Layout>

<style>
  .pt-top {
    padding-top: 120px;
  }
  
  .header-section {
    margin-bottom: 2rem;
  }
  
  .header-section h1 {
    font-size: 3rem;
    color: var(--primary);
  }
  
  .highlight {
    color: var(--accent);
  }
  
  .content-box {
    padding: 3rem;
    border-radius: 16px;
  }
  
  .zones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }
  
  .zones-list {
    list-style: none;
    padding: 0;
  }
  
  .zones-list li {
    margin-bottom: 1rem;
  }
  
  .zones-list a {
    display: block;
    padding: 1rem 1.5rem;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 8px;
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
    border: 1px solid rgba(15, 76, 129, 0.1);
    transition: all 0.3s ease;
  }
  
  .zones-list a:hover {
    background: var(--primary);
    color: var(--white);
    transform: translateX(5px);
  }

  @media (max-width: 768px) {
    .header-section h1 {
      font-size: 2.2rem;
    }
    .content-box {
      padding: 1.5rem;
    }
  }
</style>
