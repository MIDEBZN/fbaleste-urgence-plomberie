}

const { 
  name, 
  cp, 
  prep, 
  customTitle, 
  customH1, 
  customDescription, 
  landmarks, 
  neighborhoods, 
  building_context, 
  local_proof, 
  work_examples = [], 
  faqs = [], 
  nearby = [] 
} = Astro.props;

const pageTitle = customTitle || `Plombier à ${name} (${cp}) 24/7 | Dépannage et Urgences | Fbaleste`;
const pageH1 = customH1 || `Plombier à ${name} (${cp}) – Dépannage et Urgences 24/7`;
const pageDescription = customDescription || `Besoin d'un plombier en urgence sur la commune ${prep}${name} (${cp}) ? Intervention rapide, devis transparent. Débouchage, recherche de fuite, chauffagiste agréé.`;

const canonicalPath = `/zones/${Astro.params.commune}/`;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `https://www.urgenceplomberie.be${canonicalPath}#service`,
  "name": `Plombier ${name} - Dépannage & Urgences Plomberie`,
  "description": pageDescription,
  "provider": {
    "@id": "https://www.urgenceplomberie.be/#business"
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": `${name}, Région de Bruxelles-Capitale`
  },
  "url": `https://www.urgenceplomberie.be${canonicalPath}`
};

const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
} : null;

const schemasToPass = [serviceSchema];
if (faqSchema) schemasToPass.push(faqSchema);

const breadcrumbItems = [
  { name: 'Accueil', url: '/' },
  { name: 'Zones d\'intervention', url: '/zones/' },
  { name: `Plombier ${name}` }
];
---

<Layout title={pageTitle} description={pageDescription} schema={schemasToPass}>
  <Header />
  
  <main class="page-content pt-top">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <div class="container header-section text-center animate-fade-in">
      <span class="badge badge-emergency">Intervention 24/7 à {name} ({cp})</span>
      <h1>{pageH1}</h1>
      <p class="commune-lead">Votre artisan de proximité pour tout dépannage sanitaire, fuite d'eau, canalisation bouchée et problème de chaudière {prep}{name}.</p>
      <div class="header-cta-group mt-1">
        <a href="tel:+32465767511" class="btn btn-accent btn-large pulse-animation">
          📞 Appeler à {name} : 0465 76 75 11
        </a>
        <a href="/contact/" class="btn btn-primary btn-large">
          Demander un Devis Avant Travaux
        </a>
      </div>
    </div>

    <!-- Local Specifics & Context -->
    <div class="container mt-3">
      <div class="glass card content-wrap">
        <h2>Nos Services de Plomberie à {name} ({cp})</h2>
        <p>{local_proof}</p>
        <p>{building_context}</p>
        
        <div class="services-focus-grid mt-2 mb-2">
          <div class="service-focus-card">
            <h4>🚨 Dépannage d'Urgence</h4>
            <p>Fuite d'eau active, WC bouché, tuyau cassé. Sécurisation immédiate à toute heure.</p>
            <a href="/depannage-urgence/" class="sub-link">Voir notre service d'urgence 24/7 →</a>
          </div>
          <div class="service-focus-card">
            <h4>🔬 Détection de Fuite</h4>
            <p>Recherche non destructive par caméra thermique et gaz traceur avec rapport d'assurance.</p>
            <a href="/detection-fuite/" class="sub-link">Découvrir la détection sans casse →</a>
          </div>
          <div class="service-focus-card">
            <h4>🚰 Débouchage Professionnel</h4>
            <p>Curage haute pression et furet mécanique pour WC, éviers et égouts de {name}.</p>
            <a href="/debouchage/" class="sub-link">Consulter nos solutions de débouchage →</a>
          </div>
          <div class="service-focus-card">
            <h4>🔥 Dépannage Chauffage</h4>
            <p>Dépannage de chaudière au gaz, réarmement, purge de radiateurs et contrôle légal PEB.</p>
            <a href="/chauffage-chaudiere/" class="sub-link">Accéder au service chauffagiste →</a>
          </div>
        </div>

        <h3>Quartiers et Repères Desservis {prep}{name}</h3>
        <p>Nos plombiers couvrent l'intégralité du code postal {cp}, y compris les quartiers tels que <strong>{neighborhoods}</strong> et les abords de <strong>{landmarks}</strong>.</p>
      </div>
    </div>

    <!-- Work examples if available -->
    {work_examples && work_examples.length > 0 && (
      <div class="container mt-3">
        <div class="glass card content-wrap">
          <h2>Exemples Réents d'Interventions Réalisées à {name}</h2>
          <ul class="check-list mt-1">
            {work_examples.map(example => (
              <li>{example}</li>
            ))}
          </ul>
        </div>
      </div>
    )}

    <!-- Pricing and Commitment -->
    <div class="container grid mt-3 mb-3">
      <div class="glass card">
        <h2>Méthode de Facturation & Devis Écrit</h2>
        <p>Chez Fbaleste Urgence Plomberie, la transparence est absolue :</p>
        <ul class="arrow-list mt-1">
          <li><strong>Forfait Déplacement Annoncé :</strong> Tarif clair indiqué dès votre prise de contact téléphonique.</li>
          <li><strong>Devis Avant Réparation :</strong> Le technicien examine la situation et vous remet un devis précis. Aucune réparation n'est lancée sans votre feu vert explicite.</li>
          <li><strong>Garde de Nuit & Week-end :</strong> Majorations réglementées communiquées en toute clarté au préalable.</li>
          <li>Pour en savoir plus, consultez notre guide sur les <a href="/blog/tarif-plombier-bruxelles-prix/">tarifs d'un plombier à Bruxelles en 2026</a>.</li>
        </ul>
      </div>

      <div class="glass card">
        <h2>Pourquoi Faire Appel à Notre Équipe à {name} ?</h2>
        <ul class="check-list mt-1">
          <li><strong>Artisan Local :</strong> Une véritable implantation bruxelloise (siège à Etterbeek) garantissant un temps de route direct.</li>
          <li><strong>Matériel Professionnel :</strong> Équipements modernes de détection, outillage de pointe et pièces de rechange certifiées dans nos camionnettes.</li>
          <li><strong>Normes Belges :</strong> Respect scrupuleux des réglementations techniques et attestations conformes pour vos assurances.</li>
        </ul>
      </div>
    </div>
    
    <!-- Distinct 5 FAQs -->
    {faqs && faqs.length > 0 && (
      <div class="container mt-3 mb-3">
        <div class="glass card content-wrap">
          <h2>FAQ Locale : Vos Questions sur la Plomberie à {name}</h2>
          <div class="faq-list mt-2">
            {faqs.map(faq => (
              <div class="faq-item">
                <h4>{faq.question}</h4>
                <p>{faq.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}
    
    <!-- Interlinking Communes -->
    <div class="container mt-3 mb-3 text-center">
      <h3 style="color: var(--white); margin-bottom: 1rem;">Communes Limitrophes Desservies</h3>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem;">
        {nearby.map((n) => (
          <a href={`/zones/${n.slug}/`} class="btn-nearby">
            Plombier à {n.name}
          </a>
        ))}
      </div>
      <div class="mt-3">
        <a href="/zones/" class="btn btn-primary" style="margin-top: 1.5rem;">← Voir les 19 communes de Bruxelles</a>
      </div>
    </div>
  </main>
  
  <WhatsAppWidget />
  <Footer />
</Layout>

<style>
  .pt-top { padding-top: 120px; }
  .header-section h1 { font-size: 2.8rem; margin-bottom: 0.8rem; color: var(--primary); }
  .commune-lead { max-width: 750px; margin: 0 auto 1.5rem auto; font-size: 1.15rem; line-height: 1.6; }
  .header-cta-group { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  
  .badge-emergency {
    background-color: var(--accent);
    color: white;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.85rem;
    display: inline-block;
    margin-bottom: 1rem;
  }
  
  .content-wrap { padding: 3rem; border-radius: 16px; }
  .content-wrap h2 { color: var(--primary); margin-top: 0; margin-bottom: 1rem; font-size: 1.6rem; }
  .content-wrap h3 { color: var(--accent); margin-top: 1.5rem; margin-bottom: 0.8rem; font-size: 1.3rem; }
  .content-wrap p { margin-bottom: 1rem; line-height: 1.7; font-size: 1.05rem; }
  
  .services-focus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.2rem;
  }
  .service-focus-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 1.2rem;
    border-radius: 10px;
  }
  .service-focus-card h4 {
    margin: 0 0 0.5rem 0;
    color: var(--primary);
    font-size: 1.1rem;
  }
  .service-focus-card p {
    font-size: 0.9rem;
    margin-bottom: 0.8rem;
    color: var(--text-muted);
  }
  .sub-link {
    color: var(--primary);
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: underline;
  }
  .sub-link:hover { color: var(--accent); }

  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; }
  .card { padding: 2.5rem; border-radius: 16px; }
  .card h2 { color: var(--primary); margin-bottom: 1rem; font-size: 1.5rem; }
  
  .check-list { list-style: none; padding: 0; }
  .check-list li { margin-bottom: 0.8rem; position: relative; padding-left: 1.6rem; line-height: 1.6; }
  .check-list li::before { content: '✓'; position: absolute; left: 0; color: var(--primary); font-weight: bold; }
  
  .arrow-list { list-style: none; padding: 0; }
  .arrow-list li { margin-bottom: 1rem; border-bottom: 1px solid rgba(0,0,0,0.06); padding-bottom: 0.5rem; line-height: 1.6; }
  .arrow-list li strong { color: var(--primary); }
  
  .faq-list { max-width: 850px; margin: 0 auto; }
  .faq-item { margin-bottom: 1.5rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 1.2rem; }
  .faq-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .faq-item h4 { color: var(--primary); font-size: 1.15rem; margin-bottom: 0.5rem; }
  .faq-item p { color: var(--text-main); line-height: 1.6; }

  .btn-nearby {
    background: rgba(255,255,255,0.15);
    color: white;
    border: 1px solid rgba(255,255,255,0.3);
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: background 0.3s;
  }
  .btn-nearby:hover { background: rgba(255,255,255,0.3); }

  @media (max-width: 768px) {
    .header-section h1 { font-size: 2.1rem; }
    .content-wrap { padding: 1.8rem; }
  }
</style>
