---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = "Installations Sanitaires Bruxelles | Rénovation Salle de Bain & WC";
const description = "Spécialiste en installation sanitaire à Bruxelles. Pose de douches à l'italienne, baignoires, WC suspendus Geberit, éviers et robinetterie moderne.";

const faqs = [
  {
    question: "Combien de temps dure une rénovation de salle de bain à Bruxelles ?",
    answer: "Selon l'ampleur du projet (remplacement de sanitaires existants ou réfection complète avec plomberie encastrée), le délai varie généralement de 3 jours à 2 semaines. Un planning clair vous est remis dans le devis."
  },
  {
    question: "Peut-on installer un WC suspendu dans n'importe quel logement ?",
    answer: "Dans la majorité des cas oui, à condition de disposer de la profondeur nécessaire pour intégrer le bâti-support (environ 15 à 20 cm) et d'avoir un raccordement adéquat à la colonne d'évacuation générale."
  },
  {
    question: "Fournissez-vous le matériel sanitaire ou puis-je l'acheter moi-même ?",
    answer: "Nous pouvons vous fournir des sanitaires de marques professionnelles réputées (Geberit, Grohe, Hansgrohe, Villeroy & Boch) ou poser les équipements que vous avez sélectionnés par vous-même."
  },
  {
    question: "Réparez-vous les appareils électroménagers comme les lave-linge ?",
    answer: "Non. Nous assurons la création, la modification et le raccordement des conduites d'alimentation en eau et des évacuations pour machines à laver et lave-vaisselle, mais nous n'effectuons pas le dépannage mécanique ou électronique des appareils eux-mêmes."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://www.urgenceplomberie.be/installations-sanitaires/#service",
  "name": "Installation Sanitaire et Salle de Bain Bruxelles",
  "description": description,
  "provider": {
    "@id": "https://www.urgenceplomberie.be/#business"
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": "Région de Bruxelles-Capitale"
  },
  "url": "https://www.urgenceplomberie.be/installations-sanitaires/"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const breadcrumbItems = [
  { name: 'Accueil', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: 'Installations Sanitaires' }
];
---

<Layout title={title} description={description} schema={[serviceSchema, faqSchema]}>
  <Header />
  
  <main class="page-content pt-top">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <div class="container header-section text-center animate-fade-in">
      <span class="badge badge-sanitary">Artisan Sanitaire Qualifié</span>
      <h1>Installation sanitaire et rénovation à Bruxelles</h1>
      <p class="subtitle-text">Conception, pose et rénovation de salles de bain, douches, WC suspendus, vasques et robinetterie moderne dans les 19 communes de Bruxelles.</p>
      <div class="header-cta-group mt-1">
        <a href="tel:+32465767511" class="btn btn-accent btn-large pulse-animation">
          📞 0465 76 75 11 (Conseil Projet)
        </a>
        <a href="/contact/" class="btn btn-primary btn-large">
          Demander un Devis Gratuit
        </a>
      </div>
    </div>

    <div class="container grid mt-3">
      <div class="glass card">
        <h2>Prestations sanitaires incluses</h2>
        <ul class="check-list">
          <li>Rénovation complète ou partielle de salle de bain et salle d'eau</li>
          <li>Pose de douches à l'italienne, parois vitrées et receveurs extra-plats</li>
          <li>Installation de baignoires îlots ou encastrées</li>
          <li>Pose de WC suspendus (bâti Geberit) et WC classiques : voir notre service de <a href="/reparation-toilette-chasse-eau-bruxelles/">réparation de toilette et chasse d'eau</a></li>
          <li>Installation de robinetterie moderne : voir notre service de <a href="/reparation-robinetterie-bruxelles/">réparation et remplacement de robinetterie</a></li>
          <li>Raccordement en eau pour lave-linge et lave-vaisselle <em>(hors réparation de l'électroménager)</em></li>
        </ul>
      </div>

      <div class="glass card">
        <h2>Problèmes fréquents résolus</h2>
        <ul class="cross-list">
          <li>Anciennes tuyauteries en plomb à remplacer aux normes belges</li>
          <li>Pression insuffisante dans la douche ou l'évier</li>
          <li>Infiltrations sous baignoire ou autour du receveur</li>
          <li>Robinetterie entartrée ou mitigeur thermostatique bloqué</li>
          <li>Chasse d'eau encastrée inaccessible fuyant dans la cuvette</li>
        </ul>
      </div>
    </div>

    <section class="container mt-3 glass section-padding">
      <h2 class="text-center">Notre Processus d'Installation Sanitaire</h2>
      <div class="process-grid mt-2">
        <div class="process-step">
          <div class="step-num">1</div>
          <h3>Étude sur Mesure</h3>
          <p>Visite sur place pour évaluer les contraintes techniques, débits et colonnes d'évacuation existantes.</p>
        </div>
        <div class="process-step">
          <div class="step-num">2</div>
          <h3>Devis Détaillé</h3>
          <p>Chiffrage clair incluant les fournitures certifiées, la main-d'œuvre et le calendrier des travaux.</p>
        </div>
        <div class="process-step">
          <div class="step-num">3</div>
          <h3>Pose aux Normes</h3>
          <p>Raccordements soignés, mise en place des étanchéités sous carrelage et respect des pentes d'écoulement.</p>
        </div>
        <div class="process-step">
          <div class="step-num">4</div>
          <h3>Mise en Eau</h3>
          <p>Contrôle rigoureux de pression, vérification des joints et nettoyage complet du chantier.</p>
        </div>
      </div>
    </section>

    <div class="container grid mt-3">
      <div class="glass card">
        <h2>Pourquoi Nous Choisir ?</h2>
        <ul class="check-list">
          <li><strong>Grandes Marques Certifiées :</strong> Partenariats avec Geberit, Grohe, Hansgrohe et Facq pour une durabilité maximale.</li>
          <li><strong>TVA Réduite à 6% :</strong> Pour les habitations privées de plus de 10 ans en Belgique.</li>
          <li><strong>Finition Impeccable :</strong> Respect des alignements, propreté du chantier et joints d'étanchéité parfaits.</li>
        </ul>
      </div>

      <div class="glass card info-box">
        <h2>Zone d'Intervention</h2>
        <p><strong>Couverture :</strong> Région de Bruxelles-Capitale (19 communes : Uccle, Ixelles, Etterbeek, Auderghem, Schaerbeek, Bruxelles, etc.).</p>
        <p>Pour un problème d'eau très calcaire, découvrez notre service d'<a href="/traitement-eau/">adoucisseur d'eau à Bruxelles</a>.</p>
      </div>
    </div>

    <section class="container mt-3 mb-3 glass section-padding">
      <h2 class="text-center">Questions Fréquentes : Installations Sanitaires</h2>
      <div class="faq-list mt-2">
        {faqs.map(faq => (
          <div class="faq-item">
            <h4>{faq.question}</h4>
            <p>{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
  
  <WhatsAppWidget />
  <Footer />
</Layout>

<style>
  .pt-top { padding-top: 120px; }
  .header-section h1 { font-size: 2.8rem; margin-bottom: 0.8rem; color: var(--primary); }
  .subtitle-text { max-width: 750px; margin: 0 auto 1.5rem auto; font-size: 1.15rem; line-height: 1.6; color: var(--text-main); }
  .header-cta-group { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  
  .badge-sanitary {
    background-color: var(--primary);
    color: white;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.85rem;
    display: inline-block;
    margin-bottom: 1rem;
  }

  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; }
  .card { padding: 2.5rem; border-radius: 16px; }
  .card h2 { color: var(--primary); margin-bottom: 1.2rem; font-size: 1.5rem; }

  .check-list, .cross-list { list-style: none; padding: 0; }
  .check-list li, .cross-list li { margin-bottom: 0.9rem; line-height: 1.6; position: relative; padding-left: 1.6rem; }
  .check-list li::before { content: '✓'; position: absolute; left: 0; color: var(--primary); font-weight: bold; }
  .cross-list li::before { content: '⚠'; position: absolute; left: 0; color: var(--accent); font-weight: bold; }

  .section-padding { padding: 3rem; border-radius: 16px; }

  .process-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; }
  .process-step { background: rgba(255,255,255,0.7); padding: 1.5rem; border-radius: 12px; border: 1px solid #e2e8f0; }
  .step-num { width: 36px; height: 36px; background: var(--primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-bottom: 0.8rem; }
  .process-step h3 { font-size: 1.15rem; color: var(--primary); margin-bottom: 0.5rem; }
  .process-step p { font-size: 0.95rem; line-height: 1.5; color: var(--text-muted); }

  .faq-list { max-width: 850px; margin: 0 auto; }
  .faq-item { margin-bottom: 1.5rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 1.2rem; }
  .faq-item:last-child { border-bottom: none; }
  .faq-item h4 { color: var(--primary); font-size: 1.15rem; margin-bottom: 0.5rem; }
  .faq-item p { color: var(--text-main); line-height: 1.6; }

  @media (max-width: 768px) {
    .header-section h1 { font-size: 2.1rem; }
  }
</style>
